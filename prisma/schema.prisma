generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique(map: "idx_users_email")
  emailVerified Boolean   @default(false) @map("email_verified")
  memberId      String?   @unique(map: "idx_users_member_id") @map("member_id")
  name          String
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  member        Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sessions      Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  token     String   @unique(map: "idx_sessions_token")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "idx_accounts_provider_account")
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, value], map: "idx_verifications_identifier_value")
  @@map("verifications")
}

model Member {
  id                 String              @id @default(cuid())
  email              String              @unique(map: "idx_members_email")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  registrationGrants RegistrationGrant[]
  user               User?

  @@map("members")
}

model RegistrationGrant {
  id         String                  @id @default(cuid())
  memberId   String                  @map("member_id")
  email      String
  tokenHash  String                  @unique(map: "idx_registration_grants_token_hash") @map("token_hash")
  type       RegistrationGrantType
  status     RegistrationGrantStatus @default(PENDING)
  expiresAt  DateTime                @map("expires_at")
  consumedAt DateTime?               @map("consumed_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  member     Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([email, status], map: "idx_registration_grants_email_status")
  @@index([memberId], map: "idx_registration_grants_member_id")
  @@map("registration_grants")
}

enum RegistrationGrantType {
  INVITATION
  ATTACHMENT
}

enum RegistrationGrantStatus {
  PENDING
  CONSUMED
  REVOKED
}
